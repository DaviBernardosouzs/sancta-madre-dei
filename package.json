{
  "name": "sancta-mater-dei",
  "version": "0.1.0",
  "private": true,
  "description": "Sancta Mater Dei, Santa Mãe de Deus. Livro digital independente sobre Maria, com fontes e autoridade de cada decisão.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node site/scripts/verificacao/validate.mjs",
    "build": "node site/scripts/build-all.mjs",
    "build:app": "node site/scripts/build-all.mjs --app && cap sync android",
    "android:open": "cap open android",
    "test": "node --test site/tests/",
    "check": "npm run validate && npm test && npm run build && node site/scripts/verificacao/check-links.mjs",
    "serve": "node site/scripts/ferramentas/serve.mjs",
    "fetch-art": "node site/scripts/ferramentas/fetch-art.mjs",
    "prepare-images": "node site/scripts/ferramentas/prepare-images.mjs",
    "painel": "node site/scripts/ferramentas/make-painel.mjs",
    "import:dossie": "node site/scripts/ferramentas/import-dossie.mjs",
    "audit:visual": "node site/scripts/verificacao/visual-audit.mjs",
    "audit:interactions": "node site/scripts/verificacao/interaction-audit.mjs",
    "audit:performance": "node site/scripts/verificacao/performance-audit.mjs",
    "build:pt": "node site/scripts/build.mjs",
    "i18n": "node site/scripts/ferramentas/i18n.mjs",
    "i18n:keys": "I18N_COLLECT=1 LOCALE=pt node site/scripts/build.mjs",
    "mapa": "node site/scripts/ferramentas/make-map.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
