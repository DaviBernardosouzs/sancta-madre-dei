{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sancta-madre-dei",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // só a API passa pelo Worker; o resto é servido direto como arquivo estático
    "run_worker_first": ["/api/*"]
  },
  // contador de visitas anônimo (ver worker/index.js)
  "durable_objects": {
    "bindings": [{ "name": "CONTADOR", "class_name": "Contador" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Contador"] }]
}
