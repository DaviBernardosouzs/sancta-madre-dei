{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sancta-madre-dei",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",
  // sem endereço público próprio (*.workers.dev nem URLs de prévia): o site fica no Cloudflare Pages,
  // e o Pages chega ao Worker pelo Service binding API (functions/api/[[rota]].js)
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // só a API passa pelo Worker; o resto é servido direto como arquivo estático
    "run_worker_first": ["/api/*"]
  },
  // contador de visitas anônimo (worker/contador.js) e mural de pedidos de oração (worker/pedidos.js)
  "durable_objects": {
    "bindings": [
      { "name": "CONTADOR", "class_name": "Contador" },
      { "name": "PEDIDOS", "class_name": "Pedidos" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Contador"] },
    { "tag": "v2", "new_sqlite_classes": ["Pedidos"] }
  ]
}
